{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "capzIdentity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Azure name of the CAPZ identity. Defaults to `<managementCluster>-capz`."
                },
                "resourceGroup": {
                    "type": "string",
                    "description": "Resource group that holds the CAPZ identity. Defaults to `managementCluster`."
                },
                "subscriptionId": {
                    "type": "string",
                    "description": "Azure subscription ID that holds the CAPZ identity. Defaults to `spec.subscriptionID` of the AzureCluster `org-giantswarm/<managementCluster>`."
                }
            }
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "enabled": {
            "type": "boolean",
            "description": "Render the chart's resources. They need Crossplane's Azure provider, which only CAPZ management clusters run."
        },
        "externalDNSIP": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "managementCluster": {
            "type": "string",
            "description": "Name of the management cluster. The CAPZ identity's resource group and name and the Crossplane Azure ProviderConfig default to it. Required when `enabled` is `true`."
        },
        "provider": {
            "type": "string"
        },
        "providerConfigName": {
            "type": "string",
            "description": "Name of the Crossplane Azure ProviderConfig the resources use. Defaults to `managementCluster`."
        },
        "subscriptionID": {
            "type": "string"
        }
    }
}
